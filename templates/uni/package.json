    "czg": "^1.11.0",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "sass": "^1.83.4",
    "typescript": "5.7.3",
    "unocss": "0.63.4",
    "unocss-preset-weapp": "^65.4.1",
    "unplugin-auto-import": "^19.0.0",

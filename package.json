  },
  "homepage": "https://github.com/ztoec/create-zto#readme",
  "devDependencies": {
    "esbuild": "^0.23.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "kolorist": "^1.8.0",
    "prompts": "^2.4.2",
    "zx": "^8.1.4",
    "release-it": "^15.0.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "cz-git": "^1.11.0",
    "czg": "^1.11.0",
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-conventional": "^17.0.0"
